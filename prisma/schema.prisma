generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRAINER
  LEARNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                 String          @id @default(uuid())
  empId              String          @unique
  name               String
  email              String          @unique
  phone              String?
  role               Role            @default(LEARNER)
  department         String          @default("New Joiners")
  designation        String          @default("Trainee")
  passwordHash       String
  status             UserStatus      @default(ACTIVE)
  mustChangePassword Boolean         @default(true)
  joiningDate        DateTime        @default(now())
  lastActiveAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  sessions           Session[]
  videoProgress      VideoProgress[]
  quizAttempts       QuizAttempt[]
  enrollments        Enrollment[]
  certificates       Certificate[]
  announcements      Announcement[]  @relation("AuthorAnnouncements")
  notifications      Notification[]
  securityLogs       SecurityLog[]
  coursesAsTrainer   Course[]        @relation("TrainerCourses")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  deviceType   String?
  isValid      Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastActivity DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccessCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  expiresAt   DateTime?
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  courseIds   String   @default("[]")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
}

model Course {
  id                String       @id @default(uuid())
  title             String
  description       String
  thumbnail         String?
  category          String       @default("Technical & Products")
  trainerId         String?
  difficulty        String       @default("Beginner")
  estimatedDuration String       @default("2 Hours")
  status            CourseStatus @default(PUBLISHED)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  trainer       User?           @relation("TrainerCourses", fields: [trainerId], references: [id])
  modules       Module[]
  videoProgress VideoProgress[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  quizzes       Quiz[]
  documents     Document[]
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos  Video[]
  quizzes Quiz[]
}

model Video {
  id                  String   @id @default(uuid())
  moduleId            String
  title               String
  description         String?
  videoUrl            String
  thumbnailUrl        String?
  duration            Int      @default(300)
  completionThreshold Int      @default(90)
  status              String   @default("ACTIVE")
  isEncrypted         Boolean  @default(true)
  orderIndex          Int      @default(0)
  createdAt           DateTime @default(now())

  module        Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videoProgress VideoProgress[]
}

model VideoProgress {
  id                String   @id @default(uuid())
  userId            String
  videoId           String
  courseId          String
  watchedPercentage Int      @default(0)
  lastPosition      Float    @default(0.0)
  isCompleted       Boolean  @default(false)
  device            String?
  ipAddress         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  video  Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Document {
  id             String   @id @default(uuid())
  title          String
  category       String   @default("TDS")
  fileUrl        String
  isDownloadable Boolean  @default(true)
  courseId       String?
  createdAt      DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model Product {
  id                   String   @id @default(uuid())
  name                 String
  category             String
  description          String
  keyBenefits          String
  applicationProcedure String
  coverage             String?
  mixingInstructions   String?
  dosage               String?
  dosAndDonts          String?
  imageUrl             String?
  pdfUrl               String?
  videoUrl             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Quiz {
  id               String   @id @default(uuid())
  courseId         String
  moduleId         String?
  title            String
  passingScore     Int      @default(80)
  timeLimitMinutes Int      @default(15)
  maxAttempts      Int      @default(3)
  createdAt        DateTime @default(now())

  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       Module?        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  quizAttempts QuizAttempt[]
}

model QuizQuestion {
  id            String @id @default(uuid())
  quizId        String
  question      String
  options       String
  correctAnswer Int
  explanation   String?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id            String   @id @default(uuid())
  userId        String
  quizId        String
  score         Int
  passed        Boolean
  attemptNumber Int      @default(1)
  answers       String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  status      String    @default("ENROLLED")
  progress    Int       @default(0)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Certificate {
  id            String   @id @default(uuid())
  certificateId String   @unique
  userId        String
  courseId      String
  issueDate     DateTime @default(now())
  qrCodeData    String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Announcement {
  id         String   @id @default(uuid())
  title      String
  content    String
  targetRole String   @default("ALL")
  priority   String   @default("NORMAL")
  authorId   String
  createdAt  DateTime @default(now())

  author User @relation("AuthorAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?
  empId     String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  severity  String   @default("INFO")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
